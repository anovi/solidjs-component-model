{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "declarationMap": false,
    "paths": {
      "@solid-component-model/rpc": ["../rpc/src/index"],
      "solid-component-model": ["./src/index"]
    }
  },
  "include": ["src", "../rpc/src"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "../rpc/src/**/*.test.ts",
    "../rpc/src/**/*.spec.ts"
  ]
}
