{
  "name": "solid-component-model",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Aleksei Novichkov",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc --project tsconfig.build.json --noEmit && vite build",
    "build:prod": "pnpm run clean && tsc --project tsconfig.build.json --noEmit && vite build --config vite.config.prod.ts",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test-file": "vitest $npm_config",
    "bench": "pnpm run build:prod && vitest bench",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solid-component-model/rpc": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "rxjs": "7.8.2",
    "solid-js": "1.9.13",
    "vite-plugin-solid": "^2.11.12",
    "xstate": "5.32.5"
  }
}
