{
  "name": "solid-component-model/devtools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "solid-component-model": "workspace:*",
    "@solid-component-model/rpc": "workspace:*"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm run clean && tsc --project tsconfig.build.json --emitDeclarationOnly && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9"
  }
}
