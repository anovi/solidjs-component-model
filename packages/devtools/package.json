{
  "name": "solid-component-model/devtools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@ark-ui/solid": "5.39.1",
    "@solid-component-model/rpc": "workspace:*",
    "solid-component-model": "workspace:*"
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:webapp": "vite demo --config vite.config.ts",
    "build": "pnpm run clean && tsc --project tsconfig.build.json --emitDeclarationOnly && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@types/chrome": "0.2.9",
    "@types/jsdom": "30.0.0",
    "jsdom": "30.0.1",
    "solid-js": "1.9.13",
    "vite-plugin-solid": "^2.11.12"
  }
}
