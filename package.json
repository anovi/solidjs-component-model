{
  "name": "solid-component-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "test": "pnpm --recursive --if-present run test",
    "test:watch": "pnpm --recursive --if-present run test:watch",
    "test:coverage": "pnpm --recursive --if-present run test:coverage --color",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier . --write",
    "prepare": "husky",
    "clean": "pnpm --recursive --if-present run clean",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0",
    "unplugin-dts": "1.1.0",
    "vite": "^8.2.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "^5.0.0"
  }
}
