{
  "name": "solid-component-model",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Aleksei Novichkov",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && tsc && vite build && dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test-file": "vitest $npm_config",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint --fix --no-cache -c .eslintrc.json --ext .ts,.tsx ./src",
    "size": "size-limit",
    "bench": "vitest bench",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "size-limit": [
    {
      "path": "dist/index.js"
    }
  ],
  "peerDependencies": {
    "solid-js": "1.9.13"
  },
  "devDependencies": {
    "@size-limit/file": "13.0.3",
    "@types/node": "^24.13.2",
    "dts-bundle-generator": "9.5.1",
    "lint-staged": "16.4.0",
    "mermaid": "11.16.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "size-limit": "13.0.3",
    "solid-js": "1.9.13",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-solid": "^2.11.12",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "4.1.10",
    "xstate": "5.32.5"
  }
}
